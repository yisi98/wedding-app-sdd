# Copy to .env and fill in. NEVER commit .env (Principle III).

DEBUG=true

# Database (prod: postgresql+asyncpg://user:pass@host:5432/wedding)
DATABASE_URL=sqlite+aiosqlite:///./wedding.db

# Event access. In production set EVENT_PASSWORD_HASH (bcrypt) and leave EVENT_PASSWORD unset.
EVENT_PASSWORD=let-us-celebrate
# EVENT_PASSWORD_HASH=$2b$12$....

# Auth
JWT_SECRET=dev-secret-change-me
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Object storage. Leave the keys unset to use the local filesystem backend (dev/test),
# which stores under STORAGE_DIR and serves bytes via GET /media-object/{key}.
# Set the keys to use S3-compatible storage (MinIO in dev, AliCloud OSS in prod).
STORAGE_DIR=.data
# STORAGE_ENDPOINT=http://127.0.0.1:9000
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_BUCKET=wedding-media

# Real-time (Celery + WebSocket bridge). Unset ⇒ processing runs inline (eager), no Redis.
# REDIS_URL=redis://127.0.0.1:6379/0

# Web push (VAPID). Unset ⇒ push endpoints work but no notifications are sent.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com

# Email (optional; disabled entirely when SMTP_HOST is empty)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_FROM=noreply@example.com

# Production CORS allow-list (comma-separated). Ignored when DEBUG=true.
# CORS_ORIGINS=https://wedding.example.cn

# --- Frontend (set in the frontend environment, not this file) ---
# NEXT_PUBLIC_API_BASE=http://localhost:8000
# NEXT_PUBLIC_MEDIA_BASE=            # CDN base for media in prod; empty ⇒ use /media-object
