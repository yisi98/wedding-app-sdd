node_modules/
.next/
out/
coverage/
npm-debug.log*

# Editors / OS
.idea/
.vscode/
.DS_Store
Thumbs.db
*.swp

# Playwright
frontend/test-results/
frontend/playwright-report/

# Deployment artifacts (generated locally for file-sync deploys, never committed)
deploy-*.tgz
deploy-*.b64
